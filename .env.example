# Copy to .env (git-ignored) and fill in. Used by:  npm run check:sources   and   npm run start:live
# Never commit .env or the key file. See docs/implementation-notes.md §8.3.

# ---- live data: the client's two Google Sheets (read-only) ----
NIKUSHO_LIVE_ADAPTER=copy
# id = the part between /d/ and /edit in the sheet URL
NIKUSHO_COPY_SPREADSHEET_ID=<id of "NIKUSHO read-only copy (v1)">
NIKUSHO_HEARTBEAT_SPREADSHEET_ID=<id of "NIKUSHO machine heartbeat">
# Reader account = Google service account (view access granted by the client). Keep the key OUTSIDE this folder.
NIKUSHO_READER_KEY_FILE=C:/Putter/secrets/nikusho-reader.json
# Store configuration (Bangkok values confirmed 10/7 + provisional values, see the file's _note)
NIKUSHO_STORES_FILE=config/stores.json
NIKUSHO_COPY_STORE=NIKUSHO_BANGNA
# Zone of copy timestamps written without a zone (Q-12, to confirm with the client)
NIKUSHO_COPY_TIMEZONE=Asia/Bangkok

# ---- dashboard sign-in (required: real data is refused behind the dev gate) ----
NIKUSHO_AUTH=google
NIKUSHO_PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_OAUTH_CLIENT_ID=<same OAuth client as on Vercel; add http://localhost:3000/auth/callback as a redirect URI>
GOOGLE_OAUTH_CLIENT_SECRET=<from Google Cloud Console>
NIKUSHO_ALLOWLIST_FILE=config/allowlist.json
