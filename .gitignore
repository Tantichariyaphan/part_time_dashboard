# Real allowlist (personal e-mail addresses) and local secrets never go into the repository.
config/allowlist.json
.env
.env.*
!.env.example
# Service-account keys of the reader account: keep them outside the repository; these patterns are a safety net.
*.key.json
secrets/
config/reader-key*.json
# Client Source samples contain real staff names and business text: keep them out of Git and out of deployments.
docs/sample data_*/

Claude outputs/

# Extra safety nets (2026-10-19): private keys and downloaded credential files never enter Git or a deployment.
*.pem
*.p12
*credentials*.json
*service-account*.json

.vercel
.env*
