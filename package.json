{
  "name": "nikusho-monitor-skeleton",
  "version": "0.1.0",
  "private": true,
  "description": "NIKUSHO AI Monitoring System - Dashboard Skeleton + Screen Data Contract + Mock/Demo Adapter + read-only API. NOT production source integration.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:live": "node --env-file=.env server/index.js",
    "check:sources": "node --env-file=.env scripts/check-sources.js",
    "test": "node --test \"tests/*.test.js\"",
    "demo:snapshot": "node scripts/build-demo-snapshot.js",
    "diag:heartbeat": "node --env-file=.env scripts/analyze-heartbeat.js",
    "diag:reconcile": "node --env-file=.env scripts/reconcile.js",
    "diag:timing": "node --env-file=.env scripts/timing-probe.js",
    "drill:outage": "node scripts/outage-drill.js",
    "check:access": "node scripts/access-check.mjs"
  }
}
